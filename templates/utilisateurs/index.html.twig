{% extends 'base.html.twig' %}

{% block title %}Utilisateurs
{% endblock %}

{% block body %}
	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Email</th>
				<th>Roles</th>
				<th>Firstname</th>
				<th>Lastname</th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>{{ user.id }}</td>
					<td>{{ user.email }}</td>
					<td>
						{% if user.roles|length < 2 %}
							{{ user.roles[0] }}
						{% else %}
							{{ user.roles[0] }}
							{% for role in user.roles %}
							    {% if role != user.roles[0] %}, {{ role }} {% endif %}
							{% endfor %}
						{% endif %}
					</td>
					<td>{{ user.firstname }}</td>
					<td>{{ user.lastname }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
