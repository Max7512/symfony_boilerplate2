{% extends 'base.html.twig' %}

{% block title %}Vinyles{% endblock %}

{% block body %}
    <h1>Vinyles</h1>

    {% if is_granted('add_vinyle') %}
        <a href="{{ path('vinyle_add') }}">Ajouter un vinyle</a>
    {% endif %}

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Prix</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for vinyle in vinyles %}
                <tr>
                    <td>{{ vinyle.name }}</td>
                    <td>{{ vinyle.description }}</td>
                    <td>{{ vinyle.price }}</td>
                    <td>
                        {% if is_granted('edit_vinyle', vinyle) %}
                            <a href="{{ path('vinyle_edit', {'id': vinyle.id}) }}">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
